# ── Giftflow · Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# All NEXT_PUBLIC_* vars are exposed to the browser.

# ── Site ──────────────────────────────────────────────────────
# Base URL of the deployed site (no trailing slash).
# Used for canonical URLs, OG images, sitemap, etc.
NEXT_PUBLIC_SITE_URL=https://giftflow.co

# ── Plugin ────────────────────────────────────────────────────
# Download link for the free core plugin (WordPress.org)
NEXT_PUBLIC_DOWNLOAD_URL=https://wordpress.org/plugins/giftflow/

# Version badge shown in the header
NEXT_PUBLIC_PLG_VERSION=1.0.12

# ── Demo ──────────────────────────────────────────────────────
# Link to the live demo site
NEXT_PUBLIC_DEMO_URL=https://giftflow.beplusthemes.com/

# ── Pro · Checkout (Freemius) ─────────────────────────────────
# Default checkout link (annual, used as fallback)
NEXT_PUBLIC_PRO_CHECKOUT_URL=https://checkout.freemius.com/product/32092/plan/52630/?billing_cycle=yearly

# Per-plan checkout links
NEXT_PUBLIC_PRO_MONTHLY_URL=https://checkout.freemius.com/product/32092/plan/52630/?billing_cycle=monthly
NEXT_PUBLIC_PRO_ANNUAL_URL=https://checkout.freemius.com/product/32092/plan/52630/?billing_cycle=yearly
NEXT_PUBLIC_PRO_LIFETIME_URL=https://checkout.freemius.com/product/32092/plan/52630/?billing_cycle=lifetime

# Alternative Pro purchase page (CodeCanyon)
NEXT_PUBLIC_PRO_DOWNLOAD_URL=https://codecanyon.net/item/giftflow-pro-donation-fundraising-plugin-with-recurring-payments-for-wordpress/62533029/

# Pro contact / custom quote page (currently unused in components)
NEXT_PUBLIC_PRO_URL=/contact

# ── Email (Contact form) ──────────────────────────────────────
# Gmail app-password credentials for nodemailer
NEXT_PUBLIC_GMAIL_USER=
NEXT_PUBLIC_GMAIL_PASS=
